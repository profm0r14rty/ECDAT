# ECDAT local development environment
# -----------------------------------
# Copy this file to `.env` and adjust values as needed. Docker Compose reads
# `.env` automatically for the ${VAR} interpolations in docker-compose.yml.
#
# NOTE: these are dev-only defaults. The compose file also applies the same
# fallback values via ${VAR:-default}, so a plain `docker compose up --build`
# works even without a `.env` file at all.

# Postgres credentials (used by the `postgres` service and the `api` service's
# DATABASE_URL, which connects as <user>:<password>@postgres:5432/<db>).
POSTGRES_DB=ecdat
POSTGRES_USER=ecdat
POSTGRES_PASSWORD=ecdat