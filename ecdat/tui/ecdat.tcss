/* ECDAT TUI — base stylesheet.
   Colours come from the active Textual theme (registered in ecdat/tui/theme.py);
   risk colours are exposed as $risk-critical … $risk-safe. */

Screen {
    background: $background;
    color: $foreground;
}

Header {
    background: $panel;
    color: $foreground;
}

Footer {
    background: $panel;
    color: $foreground;
}

.panel {
    border: round $primary;
    padding: 0 1;
    background: $surface;
}

.muted {
    color: $foreground-muted;
}

.accent {
    color: $accent;
}

.risk-critical {
    color: $risk-critical;
}

.risk-high {
    color: $risk-high;
}

.risk-medium {
    color: $risk-medium;
}

.risk-low {
    color: $risk-low;
}

.risk-safe {
    color: $risk-safe;
}

ArtView {
    width: 100%;
    height: 100%;
}

BannerWidget {
    width: auto;
    height: auto;
}

SplashScreen {
    align: center middle;
    background: $background;
}

#splash-art {
    width: auto;
    height: auto;
}

#splash-tagline {
    width: auto;
    height: auto;
    padding: 1 0 0 0;
}

/* ------------------------------------------------------------------ */
/* Scan screen (Phase 83)                                             */
/* ------------------------------------------------------------------ */

#scan-body {
    width: 100%;
    height: 100%;
    padding: 1 2;
}

#scan-title {
    width: 100%;
    height: auto;
    padding: 0 0 1 0;
    text-style: bold;
    color: $accent;
}

#scan-left {
    width: 34;
    height: 1fr;
    padding: 0 2 0 0;
}

#scan-torus {
    width: 100%;
    height: 14;
}

#scan-counters {
    width: 100%;
    height: auto;
    padding: 1 0 0 0;
    color: $foreground-muted;
}

#scan-right {
    width: 1fr;
    height: 1fr;
}

#scan-stages {
    width: 100%;
    height: auto;
    padding: 0 0 1 0;
}

#scan-stages Static {
    width: 100%;
    height: 1;
}

#scan-progress {
    width: 100%;
    height: auto;
    padding: 0 0 1 0;
}

#scan-log {
    width: 100%;
    height: 1fr;
    border: round $primary;
    background: $surface;
}

#scan-error {
    width: 100%;
    height: auto;
    padding: 1 0;
}

/* ------------------------------------------------------------------ */
/* Results screen (Phase 84)                                          */
/* ------------------------------------------------------------------ */

#results-tabs {
    width: 100%;
    height: 1fr;
}

/* TabPane/ContentSwitcher default to height:auto, which would collapse the
   scrolling overview body to zero height. */
#results-tabs ContentSwitcher {
    height: 1fr;
}

#results-tabs TabPane {
    height: 1fr;
}

#overview-body {
    width: 100%;
    height: 1fr;
    padding: 1 2;
}

#result-top {
    width: 100%;
    height: auto;
}

#result-emblem {
    width: 21;
    height: auto;
    padding: 0 1 0 0;
}

#result-right {
    width: 1fr;
    height: auto;
}

#result-headline {
    width: 100%;
    height: auto;
    text-style: bold;
}

#result-meta {
    width: 100%;
    height: auto;
    padding: 1 0 0 0;
    color: $foreground-muted;
}

#stats-grid {
    width: 100%;
    height: auto;
    grid-size: 4 2;
    grid-gutter: 1 2;
    padding: 1 0;
}

.stat-card {
    width: 1fr;
    height: auto;
    border: round $primary;
    padding: 0 1;
}

.stat-card Digits {
    width: 100%;
    height: auto;
    text-align: center;
}

.stat-label {
    width: 100%;
    height: auto;
    text-align: center;
    color: $foreground-muted;
}

#risk-chart {
    width: 100%;
    height: auto;
    padding: 1 0 0 0;
}

#priority-list {
    width: 100%;
    height: auto;
    max-height: 12;
    border: round $primary;
}

#results-empty {
    width: 100%;
    height: auto;
    padding: 2 4;
}
